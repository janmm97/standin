# standin reads these from your environment. Copy to .env and fill in what you need.
# Never commit .env.

# One CLI connection key for Higgsfield (auto-detected from `one --agent list` when empty)
STANDIN_HIGGSFIELD_KEY=

# Higgsfield only accepts public image URLs, so Blender keyframes need a short-lived public home.
# Put/delete command templates; {path} is the local file, {key} a random object name.
# Example with Cloudflare R2 (free tier) and wrangler (https://developers.cloudflare.com/r2/):
# STANDIN_UPLOAD_CMD=npx wrangler r2 object put my-bucket/{key} --file {path} --remote
# STANDIN_DELETE_CMD=npx wrangler r2 object delete my-bucket/{key} --remote
# STANDIN_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev
STANDIN_UPLOAD_CMD=
STANDIN_DELETE_CMD=
STANDIN_PUBLIC_BASE=

# Optional overrides
# STANDIN_BLENDER=C:/Program Files/Blender Foundation/Blender 5.3/blender.exe
# STANDIN_LMSTUDIO_URL=http://localhost:1234/v1
# STANDIN_CHAT_MODEL=qwen/qwen3.5-4b
# STANDIN_VOICE_MODEL=orpheus-3b-0.1-ft
